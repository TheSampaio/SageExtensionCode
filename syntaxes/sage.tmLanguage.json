{
  "scopeName": "source.sg",
  "name": "Sage",
  "patterns": [
    { "include": "#comments" },
    { "include": "#native_resources" },
    { "include": "#native_interop" },
    { "include": "#module_names_green" },
    { "include": "#borrowing" },
    { "include": "#method_declarations" },
    { "include": "#keywords_blue" },
    { "include": "#keywords_control_purple" },
    { "include": "#storage_types_green" },
    { "include": "#namespaces_green" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#member_access" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#variables" }
  ],
  "repository": {
    "native_resources": {
      "name": "meta.declaration.resource.sage",
      "begin": "\\b(resource)\\s+([a-zA-Z_]\\w*)\\s*(:)",
      "beginCaptures": {
        "1": { "name": "keyword.other.resource.sage" },
        "2": { "name": "entity.name.type.resource.sage" },
        "3": { "name": "punctuation.separator.type.sage" }
      },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.statement.sage" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "name": "meta.destructor.resource.sage",
          "begin": "\\b(drop)\\b",
          "beginCaptures": { "1": { "name": "keyword.other.resource.sage" } },
          "end": "(?=;)",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "name": "entity.name.function.destructor.sage", "match": "\\b[a-zA-Z_]\\w*\\b" }
          ]
        },
        { "name": "entity.name.type.native.sage", "match": "\\b[a-zA-Z_]\\w*\\b" },
        { "name": "keyword.operator.pointer.sage", "match": "\\*" }
      ]
    },
    "native_interop": {
      "patterns": [
        { "include": "#extern_cpp_block" },
        { "include": "#class_handle" },
        { "include": "#native_source" }
      ]
    },
    "extern_cpp_block": {
      "name": "meta.extern.cpp.sage",
      "begin": "\\b(extern)\\s+(cpp)\\s+([a-zA-Z_]\\w*)",
      "beginCaptures": {
        "1": { "name": "keyword.other.sage" },
        "2": { "name": "storage.modifier.cpp.sage" },
        "3": { "name": "entity.name.namespace.sage" }
      },
      "end": "\\}",
      "patterns": [
        { "include": "#comments" },
        { "include": "#class_handle" },
        { "include": "#native_source" },
        { "include": "#cpp_binding_target" },
        { "include": "$self" }
      ]
    },
    "class_handle": {
      "name": "meta.declaration.class-handle.sage",
      "begin": "\\b(class)\\s+([a-zA-Z_]\\w*)\\s*(=)",
      "beginCaptures": {
        "1": { "name": "keyword.other.class.sage" },
        "2": { "name": "entity.name.type.class.sage" }
      },
      "end": "(;)|$",
      "endCaptures": { "1": { "name": "punctuation.terminator.statement.sage" } },
      "patterns": [
        { "include": "#comments" },
        { "name": "entity.name.namespace.sage", "match": "\\b[a-zA-Z_]\\w*(?=\\s*::)" },
        { "name": "entity.name.type.class.sage", "match": "\\b[a-zA-Z_]\\w*\\b" }
      ]
    },
    "native_source": {
      "match": "\\b(source)\\s*(?=\")",
      "captures": { "1": { "name": "keyword.other.source.sage" } }
    },
    "cpp_binding_target": {
      "name": "meta.binding-target.cpp.sage",
      "begin": "(=)",
      "end": "(;)|(?=\\})",
      "endCaptures": { "1": { "name": "punctuation.terminator.statement.sage" } },
      "patterns": [
        { "include": "#comments" },
        { "name": "string.quoted.double.target.sage", "begin": "\"", "end": "\"" },
        { "name": "keyword.control.sage", "match": "\\b(new|delete)\\b" },
        {
          "match": "\\b(catch)\\b(?:(\\.)(message)\\b)?",
          "captures": {
            "1": { "name": "keyword.control.catch.sage" },
            "2": { "name": "punctuation.accessor.sage" },
            "3": { "name": "variable.other.property.sage" }
          }
        },
        {
          "match": "(\\.)\\s*([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "punctuation.accessor.sage" },
            "2": { "name": "entity.name.function.member.sage" }
          }
        },
        { "name": "entity.name.namespace.sage", "match": "\\b[a-zA-Z_]\\w*(?=\\s*::)" },
        { "name": "entity.name.function.sage", "match": "\\b[a-zA-Z_]\\w*\\b" }
      ]
    },
    "method_declarations": {
      "patterns": [
        {
          "match": "\\b(method)\\b(?=\\s+func\\b)",
          "captures": { "1": { "name": "storage.modifier.method.sage" } }
        }
      ]
    },
    "member_access": {
      "patterns": [
        {
          "name": "meta.method-call.sage",
          "match": "(\\.)\\s*([a-zA-Z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.sage" },
            "2": { "name": "entity.name.function.method.sage" }
          }
        },
        {
          "match": "(\\.)\\s*([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "punctuation.accessor.sage" },
            "2": { "name": "variable.other.property.sage" }
          }
        }
      ]
    },
    "borrowing": {
      "patterns": [
        {
          "match": "(?<!&)(&)(?!&)(?:\\s*(mut)\\b)?",
          "captures": {
            "1": { "name": "keyword.operator.borrow.sage" },
            "2": { "name": "storage.modifier.borrow.sage" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sage",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sage",
          "match": "\\\\."
        },
        {
          "name": "variable.interpolation.sage",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "keyword.control.interpolation.sage" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "keyword.control.interpolation.sage" }
          },
          "patterns": [
            { "include": "source.sg" }
          ]
        }
      ]
    },
    "keywords_blue": {
      "patterns": [
        {
          "name": "keyword.other.sage",
          "match": "\\b(func|var|const|module|use|struct|extern|type)\\b"
        }
      ]
    },
    "keywords_control_purple": {
      "patterns": [
        {
          "name": "keyword.control.sage",
          "match": "\\b(if|else|while|for|return|as|break|continue|unsafe|new|delete)\\b"
        }
      ]
    },
    "storage_types_green": {
      "patterns": [
        {
          "name": "entity.name.type.sage",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|b8|c8|c16|c32|str|none|void|c_void|c_bool|c_char|c_schar|c_uchar|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_float|c_double|c_size_t|c_ssize_t|c_intptr|c_uintptr)\\b"
        }
      ]
    },
    "module_names_green": {
      "patterns": [
        {
          "match": "\\b(use|module)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.sage" },
            "2": { "name": "entity.name.namespace.sage" }
          }
        }
      ]
    },
    "namespaces_green": {
      "patterns": [
        {
          "name": "entity.name.namespace.sage",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*::)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.sage",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.sage",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [ { "name": "constant.language.sage", "match": "\\b(true|false|null)\\b" } ]
    },
    "numbers": {
      "patterns": [ { "name": "constant.numeric.sage", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" } ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.sage", "match": "//.*$" },
        { "name": "comment.block.sage", "begin": "/\\*", "end": "\\*/" }
      ]
    }
  }
}
