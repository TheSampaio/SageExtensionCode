{
  "name": "sage-lang",
  "displayName": "Sage Programming Language",
  "version": "0.3.0",
  "description": "Sage language support, commands, and Test Explorer integration for Visual Studio Code.",
  "publisher": "TheSampaio",
  "license": "MIT",
  "icon": "./icons/sage-icon.png",
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/command.test.js test/manifest.test.js test/test-results.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSampaio/vscode-sage-programming-language.git"
  },
  "categories": [
    "Programming Languages",
    "Testing"
  ],
  "keywords": [
    "sage",
    "sage-lang",
    "transpiler",
    "systems"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:sage",
    "workspaceContains:**/*.test.sg"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sage",
        "aliases": ["Sage", "sage"],
        "extensions": [".sg"],
        "icon": {
          "light": "./icons/sage-file-icon.png",
          "dark": "./icons/sage-file-icon.png"
        },
        "configuration": "./configurations/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sage",
        "scopeName": "source.sg",
        "path": "./syntaxes/sage.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sage.runFile",
        "title": "Sage: Run Current File",
        "category": "Sage"
      }
    ],
    "configuration": {
      "title": "Sage",
      "properties": {
        "sage.command": {
          "type": "string",
          "default": "sage",
          "markdownDescription": "Command used to invoke the Sage compiler. Quote paths containing spaces, for example `dotnet \"C:/My Tools/Sage.dll\"`. The target `.sg` file is appended automatically."
        },
        "sage.testGlob": {
          "type": "string",
          "default": "**/*.test.sg",
          "description": "Glob pattern used to discover Sage test files for the Test Explorer."
        }
      }
    }
  }
}
